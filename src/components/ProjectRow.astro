---
import { TYPES } from '../site.config.mjs';
import { projectUrl, projectNumber, fmtDate, topicLabel, type Project } from '../lib/projects';
interface Props { project: Project }
const { project: p } = Astro.props;
const d = p.data;
---

<article class="row">
  <div class="row__meta">
    <span class="row__num">{projectNumber(p)}</span>
    <span>{fmtDate(d.date)}</span>
    <span>{TYPES[d.type].label}{d.pages ? ` · ${d.pages} pp` : ''}{d.stats ? ` · ${d.stats.readingMinutes} min` : ''}</span>
  </div>
  <div class="row__body">
    <h3><a href={projectUrl(p)}>{d.title}</a></h3>
    <p>{d.description}</p>
    <ul class="chips">
      {d.topics.map((t) => <li><a class="chip" href={`/topics/${t}/`}>{topicLabel(t)}</a></li>)}
    </ul>
  </div>
</article>
