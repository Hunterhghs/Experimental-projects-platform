---
import { TYPES } from '../site.config.mjs';
import Signal from './Signal.astro';
import { projectUrl, projectNumber, fmtDate, topicLabel, type Project } from '../lib/projects';
interface Props { project: Project; headingLevel?: 'h2' | 'h3' }
const { project: p, headingLevel: H = 'h3' } = Astro.props;
const d = p.data;
---

<article class={`card t-${d.type}`}>
  <a class="card__link" href={projectUrl(p)} aria-label={d.title}></a>
  <div class="card__top">
    <span class="typetag"><i></i>{TYPES[d.type].label}{d.status === 'experimental' ? ' · Exp.' : ''}</span>
    <span class="id">{projectNumber(p)}</span>
  </div>
  <Signal seed={p.id} class="card__signal" />
  <H class="card__title">{d.title}</H>
  <p class="card__desc">{d.description}</p>
  <div class="card__foot">
    <span>{fmtDate(d.date, 'month')}{d.stats ? ` · ${d.stats.readingMinutes} min` : ''}{d.pages ? ` · ${d.pages} pp` : ''}</span>
    <span>{topicLabel(d.topics[0])}</span>
  </div>
</article>
