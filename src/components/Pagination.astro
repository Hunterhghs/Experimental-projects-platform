---
import type { Page } from 'astro';
interface Props { page: Page<unknown> }
const { page } = Astro.props;
---

{page.lastPage > 1 && (
  <nav class="pager" aria-label="Pagination">
    {page.url.prev ? <a href={page.url.prev} rel="prev">← Newer entries</a> : <span />}
    <span class="meta">Page {page.currentPage} of {page.lastPage}</span>
    {page.url.next ? <a href={page.url.next} rel="next">Older entries →</a> : <span />}
  </nav>
)}
