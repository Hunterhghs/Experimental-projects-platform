---
import type { GetStaticPaths, Page } from 'astro';
import Base from '../../../layouts/Base.astro';
import Ledger from '../../../components/Ledger.astro';
import Pagination from '../../../components/Pagination.astro';
import { SITE } from '../../../site.config.mjs';
import { TOPICS } from '../../../data/topics.mjs';
import { getProjects, type Project } from '../../../lib/projects';

export const getStaticPaths = (async ({ paginate }) => {
  const all = await getProjects();
  // Only topics with at least one project get a page (keeps the sitemap free of empty pages).
  return TOPICS.flatMap((topic) => {
    const items = all.filter((p) => p.data.topics.includes(topic.id));
    return items.length ? paginate(items, {
      pageSize: SITE.pageSize,
      params: { topic: topic.id },
      props: { topic },
    }) : [];
  });
}) satisfies GetStaticPaths;

const { page, topic } = Astro.props as { page: Page<Project>; topic: (typeof TOPICS)[number] };
---

<Base title={`${topic.label}${page.currentPage > 1 ? ` — page ${page.currentPage}` : ''}`} description={`${topic.description} Reports, dashboards and projects from H Heuristics.`}>
  <section class="pagehead gridpaper">
    <div class="wrap">
      <p class="kicker"><span class="sq"></span><a href="/topics/">Topics</a> / {topic.label}</p>
      <h1>{topic.label}</h1>
      <p class="pagehead__lede">{topic.description}</p>
      <p class="meta">{page.total} {page.total === 1 ? 'entry' : 'entries'}</p>
    </div>
  </section>
  <section class="wrap block">
    <Ledger items={page.data} />
    <Pagination page={page} />
  </section>
</Base>
