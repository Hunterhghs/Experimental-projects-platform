---
import type { GetStaticPaths, Page } from 'astro';
import Base from '../../layouts/Base.astro';
import Ledger from '../../components/Ledger.astro';
import Pagination from '../../components/Pagination.astro';
import { SITE, TYPES } from '../../site.config.mjs';
import { getProjects, type Project, type ProjectType } from '../../lib/projects';

export const getStaticPaths = (async ({ paginate }) => {
  const types = Object.keys(TYPES) as ProjectType[];
  const paths = await Promise.all(
    types.map(async (type) =>
      paginate(await getProjects(type), { pageSize: SITE.pageSize, params: { section: TYPES[type].section }, props: { type } }),
    ),
  );
  return paths.flat();
}) satisfies GetStaticPaths;

const { page, type } = Astro.props as { page: Page<Project>; type: ProjectType };
const meta = TYPES[type];
const title = page.currentPage > 1 ? `${meta.plural} — page ${page.currentPage}` : meta.plural;
---

<Base title={title} description={`${meta.blurb} ${page.total} ${meta.plural.toLowerCase()} from H Heuristics.`}>
  <section class="pagehead gridpaper">
    <div class="wrap">
      <p class="kicker"><span class={`sq t-${type}`}></span>Index / {meta.plural}</p>
      <h1>{meta.plural}</h1>
      <p class="pagehead__lede">{meta.blurb}</p>
      <p class="meta">{page.total} {page.total === 1 ? 'entry' : 'entries'} · newest first · <a href="/search/">search all projects</a></p>
    </div>
  </section>
  <section class="wrap block">
    {page.data.length ? (
      <Ledger items={page.data} />
    ) : (
      <div class="empty"><span class="id">— — —</span><p>No {meta.plural.toLowerCase()} published yet. The first {meta.label.toLowerCase()} is in preparation.</p></div>
    )}
    <Pagination page={page} />
  </section>
</Base>
